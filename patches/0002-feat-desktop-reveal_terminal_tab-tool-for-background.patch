+
+describe('handleDesktopBridgeEvent terminal.reveal', () => {
+  beforeEach(() => openAgentTerminal.mockClear())
+
+  it('fronts the read-only mirror tab for the session the user is looking at', () => {
+    expect(handleDesktopBridgeEvent(context(true))).toBe(true)
+    expect(openAgentTerminal).toHaveBeenCalledWith('proc_abc', 'opencode: parity-long')
+  })
+
+  it('leaves the foreground alone when the turn belongs to a background session', () => {
+    expect(handleDesktopBridgeEvent(context(false))).toBe(true)
+    expect(openAgentTerminal).not.toHaveBeenCalled()
+  })
+})
