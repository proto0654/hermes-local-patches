+#!/usr/bin/env python3
+"""Bring a background process's read-only terminal tab to the front in the Hermes
+desktop GUI (``terminal.reveal`` via ``desktop_ui``).
+
+The tab already exists: ``terminal(background=true)`` mirrors a process into the
+in-app terminal pane. That mirror is exactly what the person needs to watch a
+long run — real output, colours, no input — but it is only created in the
+background and the pane may be closed. This tool reveals the pane and selects
+the mirror's tab; it never creates a writable shell.
+
+Only the window that owns the current turn acts, and the renderer honours it only
+for the session on screen, so a background turn never steals the foreground.
+"""
+
+from tools import desktop_ui
+from tools.registry import registry, tool_error
+
+MAX_LABEL_CHARS = 200
+
+
+def reveal_terminal_tab_tool(process_id: str, title: str = "") -> str:
+    """Ask the desktop GUI to reveal ``process_id``'s read-only terminal tab."""
+    process_id = (process_id or "").strip()
+    if not process_id:
+        return tool_error("process_id must not be empty (use the id from terminal(background=true)).")
+    title = (title or "").strip()[:MAX_LABEL_CHARS]
+    return desktop_ui.emit_or_error(
+        "terminal.reveal",
+        {"process_id": process_id, "title": title},
+        "Failed to reveal the terminal tab: ",
+        "Terminal tabs are only available in the Hermes desktop app.",
+        {"success": True, "process_id": process_id},
+    )
+
+
+registry.register(
+    name="reveal_terminal_tab",
+    toolset="desktop_ui",
+    schema={
+        "name": "reveal_terminal_tab",
+        "description": (
+            "Reveal the in-app terminal tab that mirrors a background process the "
+            "agent started (the read-only live view) and bring it to the front. "
+            "Use it when the user should watch a long-running command — for "
+            "example an agent CLI launched with a background terminal — instead of "
+            "a separate window. It never types into the shell."
+        ),
+        "parameters": {
+            "type": "object",
+            "properties": {
+                "process_id": {
+                    "type": "string",
+                    "description": "Background process id (proc_…) whose mirror tab to reveal.",
+                },
+                "title": {
+                    "type": "string",
+                    "description": "Optional tab label override when the mirror is recreated.",
+                },
+            },
+            "required": ["process_id"],
+        },
+    },
+    handler=lambda args, **kw: reveal_terminal_tab_tool(
+        process_id=args.get("process_id", ""), title=args.get("title", "")
+    ),
+    emoji="🖥️",
+)
