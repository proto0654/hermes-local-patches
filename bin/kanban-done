#!/usr/bin/env python3
"""Close kanban cards with auto-generated evidence.

    kanban-done t_1234abcd ["что сделано"]
    kanban-done t_1234abcd t_5678efgh "одна строка на все"

Builds the result string itself: note + date/time + project + board + author,
so a card can be closed from the terminal without composing a summary by hand.
Finds the board that owns the task id, so --board is never needed.
"""
from __future__ import annotations

import argparse
import datetime as dt
import glob
import json
import os
import sqlite3
import subprocess
import sys

HOME = os.path.expanduser("~")
KANBAN_ROOT = os.path.join(HOME, ".hermes", "kanban")
BOARDS_GLOB = os.path.join(KANBAN_ROOT, "boards", "*", "kanban.db")
DEFAULT_DB = os.path.join(HOME, ".hermes", "kanban.db")
PROJECTS_DB = os.path.join(HOME, ".hermes", "projects.db")


def board_of(task_id: str) -> str | None:
    """Return the board slug that owns *task_id* (None for the default board)."""
    for db in [DEFAULT_DB, *sorted(glob.glob(BOARDS_GLOB))]:
        if not os.path.exists(db):
            continue
        try:
            with sqlite3.connect(f"file:{db}?mode=ro", uri=True) as conn:
                if conn.execute("select 1 from tasks where id = ?", (task_id,)).fetchone():
                    slug = os.path.basename(os.path.dirname(db))
                    return None if db == DEFAULT_DB else slug
        except sqlite3.Error:
            continue
    return ""


def project_name(board: str | None) -> str:
    if not board or not os.path.exists(PROJECTS_DB):
        return ""
    try:
        with sqlite3.connect(f"file:{PROJECTS_DB}?mode=ro", uri=True) as conn:
            row = conn.execute(
                "select name from projects where board_slug = ? and archived = 0", (board,)
            ).fetchone()
            return row[0] if row else ""
    except sqlite3.Error:
        return ""


def author() -> str:
    return os.environ.get("HERMES_PROFILE") or os.environ.get("USER") or "manual"


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("args", nargs="+", help="task ids (t_…) and an optional note")
    ap.add_argument("--board", default=None, help="board slug (auto-detected otherwise)")
    a = ap.parse_args()

    ids = [x for x in a.args if x.startswith("t_")]
    note = " ".join(x for x in a.args if not x.startswith("t_")) or "закрыто вручную"
    if not ids:
        print("no task id given", file=sys.stderr)
        return 2

    board = a.board if a.board is not None else board_of(ids[0])
    if board == "":
        print(f"task not found: {ids[0]}", file=sys.stderr)
        return 2

    stamp = dt.datetime.now().strftime("%Y-%m-%d %H:%M")
    proj = project_name(board)
    where = f"проект {proj} ({board})" if proj else (f"борда {board}" if board else "борда default")
    result = f"{note} — {stamp}, {where}, закрыл {author()}"

    cmd = ["hermes", "kanban"]
    if board:
        cmd += ["--board", board]
    cmd += ["complete", *ids, "--result", result]

    done = subprocess.run(cmd, capture_output=True, text=True)
    sys.stdout.write(done.stdout)
    sys.stderr.write(done.stderr)
    if done.returncode == 0:
        print(result)
    return done.returncode


if __name__ == "__main__":
    raise SystemExit(main())
