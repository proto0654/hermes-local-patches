#!/usr/bin/env bash
# oc-window — OpenCode TUI полосой в нижней трети экрана, тайлингом (не поверх).
#
# Зачем: панель внутри Hermes видна не всегда, а плавающее окно поверх мешает —
# перекрывает чат и перехватывает мышь. Здесь TUI встаёт отдельным ТАЙЛОВЫМ окном:
# окно сверху сжимается, TUI занимает нижнюю треть во всю ширину. Окно живёт
# ровно столько, сколько идёт прогон: сторож (oc-tui-reap) гасит TUI через
# OC_TUI_GRACE секунд простоя, foot закрывается вместе с ним.
#
# Использование:
#   oc-window <метка> <файл-задачи> [каталог]
#
# Механика: foot с app-id "oc-tui-dock" открывается тайлом, а выравнивание делает
# oc-dock-align (batch-диспатчи, ~10 мс на шаг). Hyprland не умеет открывать
# тайловое окно сразу в заданной трети — dwindle делит по длинной стороне, отсюда
# короткая перестройка «сбоку → вниз → треть».
set -euo pipefail

label=${1:?использование: oc-window <метка> <файл-задачи> [каталог]}
file=${2:?не указан файл с задачей}
dir=${3:-$PWD}

[[ -r "$file" ]] || { echo "нет файла задачи: $file" >&2; exit 2; }

export OC_TUI_GRACE=${OC_TUI_GRACE:-25}

CLASS=oc-tui-dock

prev_addr=$(hyprctl activewindow -j 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("address",""))' 2>/dev/null || true)
existing=$(hyprctl clients -j 2>/dev/null | python3 -c '
import json,sys
print(",".join(c.get("address","") for c in json.load(sys.stdin) if c.get("class")==sys.argv[1]))
' "$CLASS" 2>/dev/null || true)

foot --app-id=$CLASS \
  --title="OpenCode · $label" \
  --working-directory="$dir" \
  -e "$HOME/.local/bin/oc-tui" "$label" "$file" "$dir" &
dock_pid=$!

"$HOME/.local/bin/oc-dock-align" "$CLASS" "${prev_addr:-}" "${existing:-}" || true

wait "$dock_pid"
